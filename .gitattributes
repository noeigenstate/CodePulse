# Normalize line endings to LF in the repository
* text=auto eol=lf

# Native / binary assets must not be touched
*.node binary
*.png binary
*.ico binary
*.icns binary
pnpm-lock.yaml -text

# Firmware sources and future hardware exports retain binary bytes
*.gz binary
*.ttf binary
*.otf binary
*.pdf binary
*.xlsx binary
*.jpg binary
*.jpeg binary

# Preserve verbatim upstream font notices, including their original whitespace.
firmware/fonts/*.txt -text -whitespace
firmware/fonts/licenses/* -text -whitespace

# Docs media and hardware exports
*.webp binary
*.mp4 binary
*.zip binary
*.step -text

# Historical lab text patches must retain their exact bytes, including context whitespace.
firmware/experiments/red-lab-handoff/2026-11-08/*/source.patch -text -whitespace
firmware/experiments/red-lab-handoff/2026-11-08/*/original-build-manifest.json -text -whitespace
