# CodePulse plugin platform settings. Copy to server/.env (gitignored) and edit.
# Variables already set in the process environment take precedence over this file.

# Listen address and port. Use 0.0.0.0 to serve other machines on the LAN.
# 17888 and 17889 belong to the desktop app and are refused.
CODEPULSE_PLATFORM_HOST=127.0.0.1
CODEPULSE_PLATFORM_PORT=18080

# SQLite database; a relative path resolves against the process working directory.
CODEPULSE_PLATFORM_DB=server/.data/platform.sqlite

# Time zone for daily pack rotation and the HN "updated" time.
CODEPULSE_PLATFORM_TZ=Asia/Shanghai

# 1 allows http://127.0.0.1 or http://localhost webhooks for local development only.
CODEPULSE_PLATFORM_ALLOW_HTTP_WEBHOOK=0

# Deployment target, read by the deploy steps (never by the server itself).
# Log in with an SSH key; do not put passwords here.
CODEPULSE_DEPLOY_HOST=<host>
CODEPULSE_DEPLOY_PORT=22
CODEPULSE_DEPLOY_USER=<user>
CODEPULSE_DEPLOY_DIR=/opt/codepulse-platform
