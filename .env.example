# CodePulse desktop build settings. Copy to .env (gitignored) and edit.
# Variables already set in the process environment take precedence over this file.
# Changing CODEPULSE_PLATFORM_URL requires rebuilding the desktop app (pnpm build).

# Plugin platform origin (scheme + host + optional port, no path).
# Public domains should use https://; http:// is allowed for localhost, private LAN IPv4,
# or when CODEPULSE_PLATFORM_ALLOW_HTTP=1 is set explicitly.
CODEPULSE_PLATFORM_URL=http://127.0.0.1:18080
CODEPULSE_PLATFORM_ALLOW_HTTP=0
